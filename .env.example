# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Day 2 onwards
ANTHROPIC_API_KEY=

# Protects the scheduled job that sends reminders
CRON_SECRET=

# Day 3 onwards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# How a business connects its own Stripe, which is a different thing from the
# key above and was missing from this file entirely — so every setup ended up
# with the key that charges a card and nothing that lets a business attach an
# account for the money to land in. Without it the connect button sends
# somebody to Stripe's door and bounces them straight back.
#
# Ours, not theirs: one value for the whole platform, the same for every
# business on here. There is deliberately nowhere in the app to type it.
#
#   1. Stripe dashboard → Settings → Connect, and switch Connect on
#   2. Copy the OAuth client id. It starts ca_ and is not a secret — it
#      travels in the URL every business sees on their way to Stripe.
#   3. Register the redirect URI on that same screen, exactly:
#        https://www.second-pair.com/api/stripe/connect/callback
#      Stripe refuses any redirect it has not been told about, and that fails
#      at the far end of the flow rather than at the start — the business
#      signs in, agrees, and only then sees an error.
#   4. Add a second redirect for local work if you want it:
#        http://localhost:3000/api/stripe/connect/callback
STRIPE_CONNECT_CLIENT_ID=

# The same three again, from Stripe's test mode, for the demo salon.
#
# A demo that cannot take a payment cannot demonstrate the half of the product
# that is about money — and putting the whole deployment into test mode to show
# somebody a salon would stop a real business taking a real deposit while you
# were doing it. So the mode follows the business: a studio marked `demo` in
# the back office uses these, everybody else uses the three above, and the two
# never mix.
#
# Set all three or none. A test client id with a live secret connects an
# account that nothing can then charge.
#
#   1. Stripe dashboard, switched to test mode (the toggle, top right)
#   2. Settings → Connect → the test OAuth client id, and the same redirect URI
#      registered again on that screen:
#        https://www.second-pair.com/api/stripe/connect/callback
#   3. Developers → API keys → the test secret key
#   4. Developers → Webhooks → add the same endpoint again in test mode:
#        https://www.second-pair.com/api/stripe/webhook
#      and take its signing secret. It is a different one from the live
#      endpoint's, which is why there are two here.
#
# Then connect a sandbox account to the demo from its own settings, and pay
# with 4242 4242 4242 4242.
STRIPE_SECRET_KEY_TEST=
STRIPE_CONNECT_CLIENT_ID_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push, for telling the owner when the assistant needs them.
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email, through Resend. Without these, nothing is emailed and the screens
# say so rather than pretending it went.
#   1. resend.com → add second-pair.com as a domain
#   2. add the two TXT records it gives you at your registrar
#   3. create an API key
RESEND_API_KEY=
# Must be on the domain verified above. The business's own name goes in the
# display line at send time; this is only the address behind it.
EMAIL_FROM=info@second-pair.com

# Text messages, through Twilio. The only channel that can reach somebody who
# has not written to you first, so reminders and cancellation offers need it.
# Each business also registers its own number under Settings → Channels; the
# number is how an incoming text is routed to the right business.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used only when a business has no number of its own. Fine for sending,
# useless for receiving — a reply to a shared number cannot be routed.
TWILIO_FROM_NUMBER=

# Who can open /admin — the back office where businesses are created, priced
# and given their seats and channels.
#
# Comma-separated email addresses, matched against the signed-in session on the
# server. Unset means nobody, which is deliberate: a missing variable must never
# mean "let everybody in", and that is how this class of check usually fails.
#
# Held here rather than in the database on purpose. Every other permission in
# this product is a row somebody could in principle write; the blast radius of
# getting this one wrong is every business at once, and a variable only the
# hosting console can change is a smaller target than a table.
PLATFORM_ADMIN_EMAILS=
