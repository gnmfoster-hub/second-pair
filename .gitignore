# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
# Except the blank one, which is the setup checklist rather than a secret:
# every value in it is empty, and step 4 of the README tells you to copy it.
# `.env*` swallowed it, so a fresh clone has never contained the file the
# README sends you to — which is how a key that is genuinely required, like
# STRIPE_CONNECT_CLIENT_ID, ends up written down nowhere anybody would look.
!.env.example
.demo3.mjs
.d.mjs
.team.mjs

# Backups are every client's name and number for every business. Never in git,
# encrypted or not — an encrypted file in a repository is a file somebody will
# eventually decrypt on a laptop and leave there.
backups/
*.enc
scripts/_*.mjs
